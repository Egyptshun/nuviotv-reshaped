    <string name="settings_seek_preview_faster">Faster · balanced coverage</string>
    <string name="settings_seek_preview_fastest">Fastest · sparse coverage first</string>
    <string name="settings_seek_preview_copies">Use a smaller copy for previews</string>
    <string name="settings_seek_preview_copies_description">Use an available smaller file after checking that its pictures and timing match.</string>
    <string name="settings_seek_preview_next">Prepare next episode previews</string>
    <string name="settings_seek_preview_next_description">Prepare previews from preloaded episode sources when playback has resources to spare.</string>
