    <string name="settings_seek_preview_local">Seek bar thumbnails</string>
    <string name="settings_seek_preview_local_description">Shows thumbnails while you scrub. On-device previews use cached playback data or small downloads when resources allow; adaptive streams and mpv use a built-in frame grabber. Playback starts immediately.</string>
    <string name="settings_seek_preview_prepare">Prepare previews before playing</string>
    <string name="settings_seek_preview_prepare_description">Build previews across the title first. You can start watching at any time.</string>
